class Solution {
    public void moveZeroes(int[] nums) {
        int pos = 0;

        // Step 1: Copy all non-zeros to front
        for (int i = 0; i < nums.length; i++) {
            if (nums[i]!= 0) {
                nums[pos++] = nums[i];
            }
        }

        // Step 2: Fill remaining with zeros
        while (pos < nums.length) {
            nums[pos++] = 0;
        }
    }
}
